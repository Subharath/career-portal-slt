                    $(ctrlDependId).prop('disabled', false);
                    $(ctrlDependId).focus();
                    if (intId == 0)
                        $(ctrlDependId).prop('required', true);
                }
                else {
                    $(ctrlDependId).val('');
                    $(ctrlDependId).prop('disabled', 'disabled');
                    if (intId == 0) {
                        $(ctrlDependId).removeAttr('required', 'true');
                        $(ctrlDependId).removeClass('input-validation-error');
                    }
                }

            });
            
            //select HE qualification status - completed/following
            $("select[id$='QualStatus']").on('change', function (ev) 
            {
                var ctrlId = $(this).attr('id');
                var position = ctrlId.search("_");
                var intId = ctrlId.substring(position + 1, position + 2);

                var ctrlDependId = "#AwardedDate" + intId;
                var ctrlDependId_2 = "#HEQualifications_" + intId + "__AttachmentName" ;

                if ($(this).val() == "Completed")
                {
                    $(ctrlDependId).prop('disabled', false);
                    $(ctrlDependId_2).prop('disabled', false);

                    if (intId == 0)
                    {
                        $(ctrlDependId).prop('required', true);
                        $(ctrlDependId_2).prop('required', true);
                    }
                }
                else
                {
                    $(ctrlDependId).prop('disabled', true);
                    $(ctrlDependId_2).prop('disabled', true);

                    $(ctrlDependId).val('');
                    $(ctrlDependId_2).val('');

                    if (intId == 0)
                    {
                        $(ctrlDependId).removeAttr('required', 'true');
                        $(ctrlDependId).removeClass('input-validation-error');
                        
                        $(ctrlDependId_2).removeAttr('required', 'true');
                        $(ctrlDependId_2).removeClass('input-validation-error');
                    }
                }
            });

            //select Work experience status - left the job/currently doing
            $("select[id$='JobStatus']").on('change', function (ev) {
                var ctrlId = $(this).attr('id');
                var position = ctrlId.search("_");
                var intId = ctrlId.substring(position + 1, position + 2);

                var ctrlDependId = "#EndYearMonth" + intId;

                if ($(this).val() == "Inactive") {
                    $(ctrlDependId).prop('disabled', false);
                }
                else {
                    $(ctrlDependId).prop('disabled', true);
                    $(ctrlDependId).val('');
                }
            });
            
            function initForm()
            {     
                var year = new Date().getFullYear();
                year = year - 16;

                var maxDate = new Date(year,1,1);
                
                // max date the user can choose, in this case dates before 16 years
                maxDate = maxDate.toISOString().substring(0,10);

                //$('#PersonalData_DOB').prop('max', maxDate);

                $("#PersonalData_DOB").datepicker(
                {
                    format: 'yyyy-mm-dd',
                    minViewMode: "days",
                    startView: "years",
                    autoclose: true,
                    endDate: maxDate
                });

                $("#wizard-p-0").find("label[for^='PersonalData_Age']").each(function () {
                    $(this).hide();
                });

                $("#wizard-p-0").find("input[id^='PersonalData_Age']").each(function () {
                    $(this).hide();
                });

                $("#PersonalData_Overage").hide();

                const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
                const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));

                $("input[id^='AwardedDate']").datepicker(
                {
                        format: 'yyyy-mm',
                        minViewMode: "months",
                        startView: "months",
                        autoclose: true,
                        endDate: '+0d', //disable future dates
                });

                $("select[id^='QualName']").each(function (){
                    $(this).append('<option>Other</option>');
                });

                $("select[id$='HEInstituteName']").each(function () {
                    $(this).append('<option>Other</option>');
                });

                $("#wizard-p-3").find("input[id*='YearMonth']").each(function () {
                    $(this).datepicker(
                    {
                        format: 'yyyy-mm',
                        minViewMode: "months",
                        startView: "months",
                        autoclose: true,
                        endDate: '+0d', //disable future dates
                    });
                });
            }

            //------general functions--------
            function checkDuplicateSubjects(section)
            {
                var subjects = [];
                var noDuplicates = true;

                $(section).find("select[id*=SubjectName]").each(function () {
                    
                    var subject = $(this).val();
                    
                    if (subject != "")
                    {
                        if (subjects.includes(subject))
                        {
                            console.log(subject);
                            noDuplicates = false;
                            return false;
                        }
                        else
                        {
                            subjects.push(subject);
                        }
                    }

                });

                
                return noDuplicates;
            }

            function getAge(birthdate)
            {
                var intakecode = $("#PersonalData_IntakeCode").val();
                var dob = { birthDate: birthdate, intakeCode: intakecode };

                //var x = JSON.stringify(dob);

                $.ajax({
                    type: 'POST',
                    dataType: "json",
                    url: "@Url.Action("GetAge", "Application")", //'/Application/GetAge',
                    data: dob,
                    //contentType: 'application/json; charset=utf-8',                   
                    success: function (r) {
                        console.log("RESULT", r);
                        displayAge(r);
                    },
                    error: function (xhr, status, error) {
                        var err = eval("(" + xhr.responseText + ")");
                        alert(err.Message);
                    }
                });
            }

            function displayAge(age)
            {
                $("#wizard-p-0").find("label[for^='PersonalData_Age']").each(function () {
                    $(this).show();
                });

                $("#wizard-p-0").find("input[id^='PersonalData_Age']").each(function () {
                    $(this).show();
                });

                $("#PersonalData_AgeYears").val(age[0]);
                $("#PersonalData_AgeMonths").val(age[1]);
                $("#PersonalData_AgeDays").val(age[2]);
                $("#PersonalData_Overage").val(age[3]);

                if (age[3] != "")
                {
                    $("#PersonalData_Overage").show();
                }
                else
                {
                    $("#PersonalData_Overage").hide();
                }
            }

            function filterQualName(selectedId, ctrlId)
            {
                var ctrlQualNameId = "QualName" + ctrlId;
                var select = document.getElementById(ctrlQualNameId);

                $(select).empty();
                $(select).append('<option selected> </option>')

                $('#AllQualNames option').each(function () {
                    var optionValue = $(this).val();
                    var optionText = $(this).text();

                    if (optionValue == selectedId)
                        $(select).append('<option value="' + optionText + '">' + optionText + '</option>');
                });

                $(select).append('<option>Other</option>');
            }

            function checkFileType(section)
            {
                var isValid = true;

                var validExtensions = ["jpg", "pdf", "jpeg", "png"]

                $(section).find('input[type="file"]').each(function()
                {
                    if ($(this).val().length > 0)
                    {
                        //pop() will return the last element of the string array
                        var file = $(this).val().split('.').pop().toLowerCase();
                        if (validExtensions.indexOf(file) == -1) {
                            isValid = false;
                            return false;
                        }
                    }
                });

                return isValid;
            }

            function checkFileSize(section)
            {
                var isValid = true;

                $(section).find('input[type="file"]').each(function()
                {
                    if ($(this).val().length > 0 && this.files[0].size > 1048576) //1Mb
                    {
                        isValid = false;
                        return false;
                    }
                });

                return isValid;
            }

            function checkHEQual(section)
            {
                var isValid = true;
                var isQualNameFilled = false;
                var isQualTypeFilled = false;

                if ($(section).find("[id$='QualType']").val())
                {
                    isQualTypeFilled = true;

                    if (! $(section).find("[id^='QualName']").val())
                    {
                        isValid = false;
                    }
                }

                if ($(section).find("[id^='QualName']").val())
                {   
                    isQualNameFilled = true;

                    if ($(section).find("[id^='QualName']").val() == "Other" && ! $(section).find("[id^='OtherQualName']").val())
                    {
                        isValid = false;
                    }
                }

                var selectedText = $(section).find("[id$='QualType']").find('option:selected').text();

                if (selectedText.toUpperCase().indexOf("NVQ") >= 0 && ! $(section).find("[id$='NVQLevel']").val())
                {
                    isValid = false;
                }

                if (isQualTypeFilled && isQualNameFilled && isValid)
                {
                    if (! $(section).find("[id$='HEInstituteName']").val())
                    {
                        isValid = false;
                    }
                    else if ($(section).find("[id$='HEInstituteName']").val() == "Other" && ! $(section).find("[id^='OtherInstitute']").val())
                    {
                        isValid = false;
                    }
                }

                if (isQualNameFilled && isValid)
                {
                    if (! $(section).find("[id$='QualStatus']").val())
                    {
                        isValid = false;
                    }
                    else if ($(section).find("[id$='QualStatus']").val() == "Completed")
                    {
                        if (!$(section).find("[id^='AwardedDate']").val()) {
                            isValid = false;
                        }
                        else if (! $(section).find("[id$='AttachmentName']").val())
                        {
                            isValid = false;
                        }
                    }
                }

                return isValid;
            }

            function checkProfQual(section, subdiv)
            {
                var isValid = true;
                var filledCount = 0;
                var ctrlScope = 'ProfQualifications_' + subdiv;

                $(section).find("[id^=" + ctrlScope + "]").each(function ()
                {
                    if ($(this).val())
                        filledCount++;
                });

                if (filledCount > 0 && filledCount < 4)
                    isValid = false;
                
                return isValid;
            }

            function checkWorkExp(section, subdiv)
            {
                var isValid = true;
                var isCompanyFilled = false;
                var isPositionFilled = false;
                var ctrlScope = 'WorkExperiences_' + subdiv + '__';

                if ($(section).find("[id$='" + ctrlScope + "CompanyName']").val())
                {
                    isCompanyFilled = true;
                }

                if ($(section).find("[id$='" + ctrlScope + "PositionHeld']").val()) {
                    isPositionFilled = true;
                }

                if (isCompanyFilled && !isPositionFilled)
                {
                    return false;
                }

                if (!isCompanyFilled && isPositionFilled)
                {
                    return false;
                }
                
                if (isCompanyFilled && isPositionFilled)
                {
                    if (! $(section).find("[id$='" + ctrlScope + "EmploymentNature']").val()) {
                        isValid = false;
                        return false;
                    }

                    var ctrlDependId1 = "#StartYearMonth" + subdiv;
                    var ctrlDependId2 = "#EndYearMonth" + subdiv;

                    var jobStatus = $(section).find("[id$='" + ctrlScope + "JobStatus']").val();
                    var startDate = $(ctrlDependId1).val();
                    var endDate = $(ctrlDependId2).val();

                    //alert(jobStatus);
                    //alert(startDate);
                    //alert(endDate);

                    if (! jobStatus) {
                        isValid = false;
                        return false;
                    }
                    else
                    {
                        if (jobStatus == 'Inactive' && ! endDate) {
                            isValid = false;
                            return false;
                        }
                    }

                    if (jobStatus == 'Active' && ! startDate) {
                        isValid = false;
                        return false;
                    }
                }

                return isValid;
            }

            function ShowProgress() {
                setTimeout(function () 
                {
                    var modal = $('<div />');
                    modal.addClass("modalx");
                    $('body').append(modal);
                    var loading = $(".loading");
                    loading.show();
                    var top = Math.max($(window).height() / 2 - loading[0].offsetHeight / 2, 0);
                    var left = Math.max($(window).width() / 2 - loading[0].offsetWidth / 2, 0);
                    loading.css({ top: top, left: left });
                }, 200);
            }
        })
    </script>
