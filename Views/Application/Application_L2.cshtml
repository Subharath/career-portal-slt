@model JobApp.Models.ApplicationData

@{
    ViewData["Title"] = "Apply";
}

<style>
    .swal-text {
        color: black;
    }

    .swal-button {
        color: black;
        border-color: navy;
    }

    .swal-title {
        color: navy;
    }
</style>

<link href="~/css/application_specific.css" rel="stylesheet" />
<link href="~/lib/jquery-section/css/jquery.steps.css" rel="stylesheet" />
<link href="~/lib/datepicker/css/bootstrap-datepicker.min.css" rel="stylesheet" />
<link href="~/css/application_modern_theme.css" rel="stylesheet" />
<link href="~/css/application_modern_form.css" rel="stylesheet" />
<link href="~/css/application_modern_wizard.css" rel="stylesheet" />


<div class="mb-4">
    <h3>Application for the Post of <small class="text-muted">@ViewBag.JobPositionName</small></h3>
    <p class="text-muted mb-0" style="color:#546E7A !important;">
        Please complete each step carefully and upload clear supporting documents.
    </p>
</div>
<partial name="_LoadingPartial" />

<hr />
<div class="alert alert-warning alert-dismissible fade show" role="alert">
    <strong>Note:</strong> File attachments must not exceed 1MB.
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<div class="row">
    <div class="col-md-12">
        <form enctype="multipart/form-data" asp-action="Apply" id="applicationForm" autocomplete="on">
            <input type="hidden" value="@ViewBag.JobPositionName" id="jobPositionName" name="jobPositionName"/>

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <input type="hidden" asp-for="PersonalData.ApplicationID" class="form-control" />
            </div>
            <div class="form-group">
                <input type="hidden" asp-for="PersonalData.ApplicationCode" class="form-control" />
            </div>
            <div class="form-group">
                <input type="hidden" asp-for="PersonalData.IntakeCode" class="form-control" />
            </div>

            <div id="wizard">
                <h2>Personal Information</h2>
                <section>
                    <div class="form-group row">
                        <div class="col-12 col-sm-6 col-md-2 form-group">
                            <label asp-for="PersonalData.Salutation" class="control-label required"></label>
                            <select asp-for="PersonalData.Salutation" class="form-control form-control-sm" autofocus>
                                <option>Mr</option>
                                <option>Mrs</option>
                                <option>Miss</option>
                            </select>                        
                        </div>
                        <div class="col-12 col-sm-6 col-md-2 form-group">
                            <label asp-for="PersonalData.Initials" class="control-label required"></label>
                            <input asp-for="PersonalData.Initials" class="form-control form-control-sm text-uppercase" maxlength="10" placeholder="e.g. KAD" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Do not seperate with spaces/dots" />
                            <span asp-validation-for="PersonalData.Initials" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-sm-6 col-md-3 form-group">
                            <label asp-for="PersonalData.Surname" class="control-label required"></label>
                            <input asp-for="PersonalData.Surname" class="form-control form-control-sm text-capitalize" maxlength="50" placeholder="e.g. Silva" />
                            <span asp-validation-for="PersonalData.Surname" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-sm-6 col-md-5 form-group">
                            <label asp-for="PersonalData.FullName" class="control-label required"></label>
                            <input asp-for="PersonalData.FullName" class="form-control form-control-sm text-capitalize" maxlength="100" placeholder="e.g. Kamal Anurudda Dushen Silva" />
                            <span asp-validation-for="PersonalData.FullName" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group row">
                        <div class="col-12 col-sm-6 col-md-3 form-group">
                            <label asp-for="PersonalData.NIC" class="control-label required"></label>
                            <input asp-for="PersonalData.NIC" class="form-control form-control-sm text-uppercase" maxlength="12" />
                            <span asp-validation-for="PersonalData.NIC" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-sm-6 col-md-3 form-group">
                            <label asp-for="PersonalData.DOB" class="control-label required"></label>
                            <input asp-for="PersonalData.DOB" class="form-control form-control-sm" asp-format="{0:yyyy-MM-dd}" type="text" readonly="readonly" style="background-color:white;" required/>
                        </div>
                        <div class="col-4 col-sm-4 col-md-1 form-group">
                            <label asp-for="PersonalData.AgeYears" class="control-label optional"></label>
                            <input asp-for="PersonalData.AgeYears" class="form-control form-control-sm" readonly />
                            <span asp-validation-for="PersonalData.AgeYears" class="text-danger"></span>
                        </div>
                        <div class="col-4 col-sm-4 col-md-1 form-group">
                            <label asp-for="PersonalData.AgeMonths" class="control-label optional"></label>
                            <input asp-for="PersonalData.AgeMonths" class="form-control form-control-sm" readonly />
                        </div>
                        <div class="col-4 col-sm-4 col-md-1 form-group">
                            <label asp-for="PersonalData.AgeDays" class="control-label optional"></label>
                            <input asp-for="PersonalData.AgeDays" class="form-control form-control-sm" readonly />
                        </div>
                        <div class="col-12 col-sm-6 col-md-2 form-group">
                            <label class="dummy-label"></label>
                            <input asp-for="PersonalData.Overage" class="form-control form-control-sm" readonly />
                        </div>
                    </div>
                    <div class="col-4 form-group">
                        <p class="control-label required">Address</p>
                        <input asp-for="PersonalData.HouseNo" class="form-control form-control-sm" placeholder="House/Building/Apartment Number" maxlength="30" />
                    </div>
                    <div class="col-6 form-group">
                        <input asp-for="PersonalData.AddressLine1" class="form-control form-control-sm" placeholder="Address Line 1" maxlength="50" />
                    </div>
                    <div class="col-6 form-group">
                        <input asp-for="PersonalData.AddressLine2" class="form-control form-control-sm" placeholder="Address Line 2" maxlength="50" />
                    </div>
                    <div class="col-6 form-group">
                        <input asp-for="PersonalData.AddressLine3" class="form-control form-control-sm" placeholder="Address Line 3" maxlength="50" />
                    </div>
                    <div class="col-6 form-group">
                        <input asp-for="PersonalData.AddressLine4" class="form-control form-control-sm" placeholder="Address Line 4" maxlength="50" />
                    </div>
                    <div class="form-group row">
                        <div class="col-6 form-group">
                            <label asp-for="PersonalData.Email" class="control-label required"></label>
                            <input asp-for="PersonalData.Email" class="form-control form-control-sm" maxlength="50" required/>
                            <span asp-validation-for="PersonalData.Email" class="text-danger"></span>
                        </div>
                        <div class="col-3 form-group">
                            <label asp-for="PersonalData.ContactNo1" class="control-label required"></label>
                            <input asp-for="PersonalData.ContactNo1" class="form-control form-control-sm" placeholder="Personal Mobile Number" maxlength="10" />
                            <span asp-validation-for="PersonalData.ContactNo1" class="text-danger"></span>
                        </div>
                        <div class="col-3 form-group">
                            <label asp-for="PersonalData.ContactNo2" class="control-label optional"></label>
                            <input asp-for="PersonalData.ContactNo2" class="form-control form-control-sm" placeholder="Secondary Contact Number" maxlength="10" />
                            <span asp-validation-for="PersonalData.ContactNo2" class="text-danger"></span>
                        </div>
                    </div>
@*                    <div class="form-group">
                        <label asp-for="PersonalData.Overage" class="control-label"></label>
                        <input asp-for="PersonalData.Overage" class="form-control" />
                        <span asp-validation-for="PersonalData.Overage" class="text-danger"></span>
                    </div>*@
                    <div class="form-group">
                        <input type="submit" value="Create" class="btn btn-primary" id="btnPersonalData" style="display:none"/>
                    </div>
                </section>
                
                <h2>Higher Education Qualifications</h2>
                <section>
                    <div class="alert alert-dark">
                        <h6>Specify in the order of relevancy.</h6>
                        <h6 class="message">Qualifications without proof will be discarded. i.e. Attach the relevant certificate for each qualification.</h6>
                    </div>
                    <div class="accordion" id="accordionHEQual">
                        @*/Higher Education Panel 1*@
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="heading1">
                                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapse1" aria-expanded="true" aria-controls="collapse1">
                                    1. Most relevant qualification
                                </button>
                            </h2>
                            <div id="collapse1" class="accordion-collapse collapse show" aria-labelledby="heading1" data-bs-parent="#accordionHEQual">
                                <div class="accordion-body">
                                    <div class="form-group row">
                                        <div class="col-3 form-group">
                                            <label asp-for="HEQualifications[0].QualType" class="control-label"></label>
                                            <select asp-for="HEQualifications[0].QualType" asp-items="@ViewBag.QualType" class="form-select form-select-sm" required>
                                                <option disabled selected></option>
                                            </select>
                                        </div>
                                        <div class="col-2 form-group">
                                            <label asp-for="HEQualifications[0].NVQLevel" class="control-label"></label>
                                            <select asp-for="HEQualifications[0].NVQLevel" asp-items="@ViewBag.NVQLevel" class="form-select form-select-sm" disabled>
                                                <option disabled selected></option>
                                            </select>
                                        </div>
                                    </div>
                                     <div class="form-group row">
                                        <div class="col-5 form-group">
                                            <label asp-for="HEQualifications[0].QualName" class="control-label required"></label>
                                            <select asp-for="HEQualifications[0].QualName" id="QualName0" asp-items="@ViewBag.QualName" class="form-select form-select-sm" disabled required>
                                                <option disabled selected></option>
                                            </select>
                                        </div>
                                        <div class="col-5 form-group">
                                            <label class="dummy-label"></label>
                                            <input asp-for="HEQualifications[0].OtherQualName" class="form-control form-control-sm" maxlength="50" id="OtherQualName0" placeholder="Specify the non-listed qualification" disabled />
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-5 form-group">
                                            <label asp-for="HEQualifications[0].HEInstituteName" class="control-label required"></label>
                                            <select asp-for="HEQualifications[0].HEInstituteName" asp-items="@ViewBag.HEInstitute" class="form-select form-select-sm" required>
                                                <option disabled selected></option>
                                            </select>
                                        </div>
                                        <div class="col-5 form-group">
                                            <label class="dummy-label"></label>
                                            <input asp-for="HEQualifications[0].OtherInstitute" class="form-control form-control-sm" maxlength="50" id="OtherInstitute0" placeholder="Specify the non-listed institute/university" disabled />
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-4 form-group">
                                            <label asp-for="HEQualifications[0].SpecializedArea" class="control-label required"></label>
                                            <input asp-for="HEQualifications[0].SpecializedArea" maxlength="50" class="form-control form-control-sm" required />
                                        </div>
                                        <div class="col-3 form-group">
                                            <label asp-for="HEQualifications[0].QualStatus" class="control-label required"></label>
                                            <select asp-for="HEQualifications[0].QualStatus" class="form-select form-select-sm" required>
                                                <option disabled selected></option>
                                                <option>Completed</option>
                                                <option>Following</option>
                                            </select>
                                        </div>
                                        <div class="col-3 form-group">
                                            <label asp-for="HEQualifications[0].AwardedYearMonth" class="control-label optional"></label>
                                            <input asp-for="HEQualifications[0].AwardedYearMonth" class="form-control form-control-sm" id="AwardedDate0"/>
                                        </div>
                                    </div>
                                    <div class="col-8 form-group">
                                        <label asp-for="HEQualifications[0].AttachmentName" class="control-label required"></label>
                                        <input asp-for="HEQualifications[0].AttachmentName" class="form-control form-control-sm" type="file" required/>
                                    </div>
                                    <br />
                                </div>
                            </div>
                        </div>

                        @*/Higher Education Panel 2*@
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="heading2">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse2" aria-expanded="false" aria-controls="collapse2">
                                    2. Other qualifications
                                </button>
                            </h2>
                            <div id="collapse2" class="accordion-collapse collapse" aria-labelledby="heading2" data-bs-parent="#accordionHEQual">
                                <div class="accordion-body">
                                    <div class="form-group row">
                                        <div class="col-3 form-group">
                                            <label asp-for="HEQualifications[1].QualType" class="control-label"></label>
                                            <select asp-for="HEQualifications[1].QualType" asp-items="@ViewBag.QualType" class="form-select form-select-sm">
                                                <option selected></option>
                                            </select>
                                        </div>
                                        <div class="col-2 form-group">
                                            <label asp-for="HEQualifications[1].NVQLevel" class="control-label"></label>
                                            <select asp-for="HEQualifications[1].NVQLevel" asp-items="@ViewBag.NVQLevel" class="form-select form-select-sm" disabled>
                                                <option selected></option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-5 form-group">
                                            <label asp-for="HEQualifications[1].QualName" class="control-label optional"></label>
                                            <select asp-for="HEQualifications[1].QualName" id="QualName1" asp-items="@ViewBag.QualName" class="form-select form-select-sm" disabled>
                                                <option selected></option>
                                            </select>
                                        </div>
                                        <div class="col-5 form-group">
                                            <label class="dummy-label"></label>
                                            <input asp-for="HEQualifications[1].OtherQualName" class="form-control form-control-sm" maxlength="50" id="OtherQualName1" placeholder="Specify the non-listed qualification" disabled />
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-5 form-group">
                                            <label asp-for="HEQualifications[1].HEInstituteName" class="control-label optional"></label>
                                            <select asp-for="HEQualifications[1].HEInstituteName" asp-items="@ViewBag.HEInstitute" class="form-select form-select-sm">
                                                <option selected></option>
                                            </select>
                                        </div>
                                        <div class="col-5 form-group">
                                            <label class="dummy-label"></label>
                                            <input asp-for="HEQualifications[1].OtherInstitute" class="form-control form-control-sm" maxlength="50" id="OtherInstitute1" placeholder="Specify the non-listed institute/university" disabled />
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-4 form-group">
                                            <label asp-for="HEQualifications[1].SpecializedArea" class="control-label"></label>
                                            <input asp-for="HEQualifications[1].SpecializedArea" class="form-control form-control-sm" maxlength="50" />
                                        </div>
                                        <div class="col-3 form-group">
                                            <label asp-for="HEQualifications[1].QualStatus" class="control-label"></label>
                                            <select asp-for="HEQualifications[1].QualStatus" class="form-select form-select-sm">
                                                <option selected></option>
                                                <option>Completed</option>
                                                <option>Following</option>
                                            </select>
                                        </div>
                                        <div class="col-3 form-group">
                                            <label asp-for="HEQualifications[1].AwardedYearMonth" class="control-label"></label>
                                            <input asp-for="HEQualifications[1].AwardedYearMonth" class="form-control form-control-sm" id="AwardedDate1" />
                                        </div>
                                    </div>
                                    <br />
                                    <div class="col-8 form-group">
                                        <label asp-for="HEQualifications[1].AttachmentName" class="control-label"></label>
                                        <input asp-for="HEQualifications[1].AttachmentName" class="form-control form-control-sm" type="file"/>
                                    </div>
                                    <br />
                                </div>
                            </div>
                        </div>

                        @*/Higher Education Panel 3*@
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="heading3">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse3" aria-expanded="false" aria-controls="collapse3">
                                    3. Other qualifications
                                </button>
                            </h2>
                            <div id="collapse3" class="accordion-collapse collapse" aria-labelledby="heading3" data-bs-parent="#accordionHEQual">
                                <div class="accordion-body">
                                    <div class="form-group row">
                                        <div class="col-3 form-group">
                                            <label asp-for="HEQualifications[2].QualType" class="control-label"></label>
                                            <select asp-for="HEQualifications[2].QualType" asp-items="@ViewBag.QualType" class="form-select form-select-sm">
                                                <option selected></option>
                                            </select>
                                        </div>
                                        <div class="col-2 form-group">
                                            <label asp-for="HEQualifications[2].NVQLevel" class="control-label"></label>
                                            <select asp-for="HEQualifications[2].NVQLevel" asp-items="@ViewBag.NVQLevel" class="form-select form-select-sm" disabled>
                                                <option selected></option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-5 form-group">
                                            <label asp-for="HEQualifications[2].QualName" class="control-label optional"></label>
                                            <select asp-for="HEQualifications[2].QualName" id="QualName2" asp-items="@ViewBag.QualName" class="form-select form-select-sm" disabled>
                                                <option selected></option>
                                            </select>
                                        </div>
                                        <div class="col-5 form-group">
                                            <label class="dummy-label"></label>
                                            <input asp-for="HEQualifications[2].OtherQualName" class="form-control form-control-sm" maxlength="50" id="OtherQualName2" placeholder="Specify the non-listed qualification" disabled />
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-5 form-group">
                                            <label asp-for="HEQualifications[2].HEInstituteName" class="control-label optional"></label>
                                            <select asp-for="HEQualifications[2].HEInstituteName" asp-items="@ViewBag.HEInstitute" class="form-select form-select-sm">
                                                <option selected></option>
                                            </select>
                                        </div>
                                        <div class="col-5 form-group">
                                            <label class="dummy-label"></label>
                                            <input asp-for="HEQualifications[2].OtherInstitute" class="form-control form-control-sm" maxlength="50" id="OtherInstitute2" placeholder="Specify the non-listed institute/university" disabled />
                                        </div>
                                    </div>

                                    <div class="form-group row">
                                        <div class="col-4 form-group">
                                            <label asp-for="HEQualifications[2].SpecializedArea" class="control-label"></label>
                                            <input asp-for="HEQualifications[2].SpecializedArea" class="form-control form-control-sm" maxlength="50" />
                                        </div>
                                        <div class="col-3 form-group">
                                            <label asp-for="HEQualifications[2].QualStatus" class="control-label"></label>
                                            <select asp-for="HEQualifications[2].QualStatus" class="form-select form-select-sm">
                                                <option selected></option>
                                                <option>Completed</option>
                                                <option>Following</option>
                                            </select>
                                        </div>
                                        <div class="col-3 form-group">
                                            <label asp-for="HEQualifications[2].AwardedYearMonth" class="control-label"></label>
                                            <input asp-for="HEQualifications[2].AwardedYearMonth" class="form-control form-control-sm" id="AwardedDate2" />
                                        </div>
                                    </div>
                                    <br />
                                    <div class="col-8 form-group">
                                        <label asp-for="HEQualifications[2].AttachmentName" class="control-label"></label>
                                        <input asp-for="HEQualifications[2].AttachmentName" class="form-control form-control-sm" type="file" />
                                    </div>
                                    <br />
                                </div>
                            </div>
                        </div>
                    </div>
                    @*dummy dropdown with all qualification names*@
                    <select id="AllQualNames" asp-items="@ViewBag.QualName" style="display:none">
                    </select>

                    <div class="form-group">
                        <input type="submit" value="Create" class="btn btn-primary" id="btnHEQual" style="display:none"/>
                    </div>
                </section>

                <h2>Professional Membership Qualifications</h2>
                <section>
                    <div class="alert alert-dark">
                        <h6>Specify in the order of relevancy.</h6>
                        <h6 class="message">Qualifications without proof will be discarded. i.e. Attach the relevent certificate for each qualification.</h6>
                    </div>
                    @{
                        for(int i = 0; i <= 1; i++)
                        {
                            <h4><span class="badge bg-primary">@(i+1)</span></h4>
                            
                            <div class="form-group row">
                                <div class="col-3 form-group">
                                    <label asp-for="ProfQualifications[i].MembershipType" class="control-label"></label>
                                    <select asp-for="ProfQualifications[i].MembershipType" asp-items="@ViewBag.MembershipType" class="form-select form-select-sm">
                                        <option selected></option>
                                    </select>
                                </div>
                                <div class="col-3 form-group">
                                    <label asp-for="ProfQualifications[i].PQInsituteName" class="control-label"></label>
                                    <select asp-for="ProfQualifications[i].PQInsituteName" asp-items="@ViewBag.PQInstitute" class="form-select form-select-sm">
                                        <option selected></option>
                                    </select>
                                </div>
                                <div class="col-3 form-group">
                                    <label asp-for="ProfQualifications[i].MembershipNo" class="control-label"></label>
                                    <input asp-for="ProfQualifications[i].MembershipNo" class="form-control form-control-sm" maxlength="20" />
                                </div>
                            </div>
                            
                            <br />

                            <div class="col-8 form-group">
                                <label asp-for="ProfQualifications[i].AttachmentName" class="control-label"></label>
                                <input asp-for="ProfQualifications[i].AttachmentName" class="form-control form-control-sm" type="file" />
                            </div>

                            <hr />
                        }
                    }
                    
                    <br />
                    <div class="form-group">
                        <input type="submit" value="Create" class="btn btn-primary" id="btnProfQual" style="display:none" />
                    </div>
                </section>

                <h2>Work Experience</h2>
                <section>
                    <div class="alert alert-dark">
                        <h6>Please follow reverse-chronological order (i.e. most recent experience first).</h6>
                    </div>
                    @{
                        for (int i = 0; i <= 1; i++)
                        {
                            <h4><span class="badge bg-primary">@(i + 1)</span></h4>

                            <div class="form-group row">
                                <div class="col-5 form-group">
                                    <label asp-for="WorkExperiences[i].CompanyName" class="control-label"></label>
                                    <input asp-for="WorkExperiences[i].CompanyName" class="form-control form-control-sm" maxlength="50" />
                                </div>
                                <div class="col-5 form-group">
                                    <label asp-for="WorkExperiences[i].PositionHeld" class="control-label"></label>
                                    <input asp-for="WorkExperiences[i].PositionHeld" class="form-control form-control-sm" maxlength="50" />
                                </div>
                                <div class="col-2 form-group">
                                    <label asp-for="WorkExperiences[i].EmploymentNature" class="control-label"></label>
                                    <select asp-for="WorkExperiences[i].EmploymentNature" class="form-select form-select-sm">
                                        <option selected></option>
                                        <option>Trainee/Intern</option>
                                        <option>Permanent</option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-3 form-group">
                                    <label asp-for="WorkExperiences[i].JobStatus" class="control-label"></label>
                                    <select asp-for="WorkExperiences[i].JobStatus" class="form-select form-select-sm">
                                        <option selected></option>
                                        <option value="Active">Active (Currently doing job)</option>
                                        <option value="Inactive">Inactive (Left job)</option>
                                    </select>
                                </div>
                                <div class="col-2 form-group">
                                    <label asp-for="WorkExperiences[i].StartYearMonth" class="control-label"></label>
                                    <input asp-for="WorkExperiences[i].StartYearMonth" class="form-control form-control-sm" id="StartYearMonth@(i)" />
                                </div>
                                <div class="col-2 form-group">
                                    <label asp-for="WorkExperiences[i].EndYearMonth" class="control-label"></label>
