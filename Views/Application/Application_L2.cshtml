            //control events
            $("#PersonalData_DOB").on('change', function (ev) {
                var dob = $(this).val();
                getAge(dob);
                //alert(dob);
            });

            //select qualtype ^ at the start, $ at the end, * anywhere
            $("select[id$='QualType']").on('change', function (ev) 
            {
                var ctrlId = $(this).attr('id');
                var position = ctrlId.search("_");
                var intId = ctrlId.substring(position + 1, position + 2);
                
                var ctrlDependId = "#HEQualifications_" + intId + "__NVQLevel";
                var ctrlDependId_2 = "#QualName" + intId;
                var ctrlDependId_3 = "#OtherQualName" + intId;

                filterQualName($(this).val(), intId);
                
                $(ctrlDependId_3).val('');
                $(ctrlDependId_3).prop('disabled', true);

                var selectedText = $(this).find('option:selected').text();

                if (selectedText != "")
                    $(ctrlDependId_2).prop('disabled', false);
                else
                    $(ctrlDependId_2).prop('disabled', true);

                if (selectedText.toUpperCase().indexOf("NVQ") >= 0)
                {
                    $(ctrlDependId).prop('disabled', false);
                    if (intId == 0)
                        $(ctrlDependId).prop('required', true);
                }
                else
                {
                    $(ctrlDependId).prop('disabled', true);
                    $(ctrlDependId).prop('selected', false);
                    $(ctrlDependId).val('');
                    if (intId == 0)
                    {
                        $(ctrlDependId).removeAttr('required', 'true');
                        $(ctrlDependId).removeClass('input-validation-error');
                    }
                }
            });

            //enable/disable textbox to type non-listed qual name
            $("select[id^='QualName']").on('change', function (ev)
            {
                var ctrlId = $(this).attr('id');
                var position = 7; //ctrlId.search("_");
                var intId = ctrlId.substring(position + 1, position + 2);

                var ctrlDependId = "#OtherQualName" + intId;

                if ($(this).val().toLowerCase() == 'other')
                {
                    $(ctrlDependId).prop('disabled', false);
                    $(ctrlDependId).focus();
                    if (intId == 0)
                        $(ctrlDependId).prop('required', true);

                }
                else 
                {
                    $(ctrlDependId).val('');
                    $(ctrlDependId).prop('disabled', 'disabled');
                    if (intId == 0) {
                        $(ctrlDependId).removeAttr('required', 'true');
                        $(ctrlDependId).removeClass('input-validation-error');
                    }
                }

            });

