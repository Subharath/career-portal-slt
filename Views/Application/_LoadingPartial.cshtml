<style>

.modalx {
    position: fixed;
    top: 0;
    left: 0;
    background-color: black;
    z-index: 99;
    opacity: 0.5;
    filter: alpha(opacity=80);
    -moz-opacity: 0.5;
    min-height: 100%;
    width: 100%;
}

.loading
{
    /*font-family: 'Calibri';*/
    font-size: 15pt;
    border: none;
    width: 380px;
    height: 200px;
    border-radius: 10px;
    display: none;
    position: fixed;
    background-color: white;
    z-index: 999;
    text-align: center;
    line-height: 50px;
}

.textSpan {
    display: inline-block;
    vertical-align: top;
    line-height: normal;
}
</style>

@{
    <div class="loading" align="center">
            <div class="d-flex justify-content-center pt-5">
                <div class="spinner-border text-primary mb-3"
                        style="width: 3rem; height: 3rem;"
                        role="status" >
                </div>
            </div>
            <span class="textSpan">Please wait while we acknowledge your application</span>
    </div>
}
