<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SLT JobApp</title>
    
    <!-- Modern Fonts & AOS Animations -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" rel="stylesheet" />

    <!-- Modern CSS Variables & Styles -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/animations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/JobApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css" rel="stylesheet" />
    @* new *@

    <link href="https://cdnjs.cloudflare.com/ajax/libs/jquery-steps/1.1.0/jquery.steps.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/css/bootstrap-datepicker.min.css" rel="stylesheet" />

    <link href="~/css/application_modern_theme.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/application_modern_form.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/application_modern_wizard.css" rel="stylesheet" asp-append-version="true" />








</head>
<body class="app-shell">
    <!-- Scroll Progress Indicator -->
    <div id="scroll-progress-bar"></div>

    <!-- Global Loading Spinner -->
    <div id="global-loader" class="global-loader">
        <div class="slt-spinner">
            <div class="bounce1"></div>
            <div class="bounce2"></div>
            <div class="bounce3"></div>
        </div>
        <div class="loader-text">Loading SLT JobApp...</div>
    </div>

    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="sticky-top z-1030 app-header">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm modern-navbar app-navbar" aria-label="Primary navigation">
            <div class="container">
                <div class="navbar-brand-wrapper d-flex align-items-center gap-3">
                    <a class="navbar-brand m-0 p-0" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="~/images/jobapplogo.png" alt="SLT JOBAPP" width="165" height="40" />
                    </a>
                    <div class="brand-divider"></div>
                    <a class="navbar-brand-secondary m-0 p-0" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="~/images/logo.png" alt="Brand" width="112" height="40" />
                    </a>
                </div>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" 
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end align-items-center">
                    <ul class="navbar-nav ms-auto align-items-center">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-briefcase me-1"></i> Apply Now
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Instructions">
                                <i class="fas fa-book me-1"></i> Guide Lines
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container app-content-wrap flex-grow-1 mt-4">
        <main role="main" id="main-content" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="modern-footer">
        <div class="container">
            <div class="footer-content">
                <div class="copyright">
                    &copy; <span class="year">2026</span> SLT MOBITEL - Job Application Portal
                </div>
                <div>
                    <small>Powered by SLT Digital Platforms</small>
                </div>
            </div>
        </div>
    </footer>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="~/js/workexperience-handler.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    
</body>
</html>
