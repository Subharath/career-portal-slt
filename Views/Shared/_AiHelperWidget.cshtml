<button id="aiFab" class="ai-fab-liquid" type="button" aria-label="Open Help Center">
    <i class="fas fa-headset"></i>
</button>

<div id="aiWidget" class="ai-help-widget" aria-hidden="true">
    <div class="ai-help-shell">
        <div class="ai-help-header">
            <div class="ai-help-header-left">
                <div class="ai-help-icon">
                    <i class="fas fa-headset"></i>
                </div>
                <div>
                    <h3 class="ai-help-title">How can we assist you?</h3>
                </div>
            </div>

            <button id="aiClose" class="ai-help-close" type="button" aria-label="Close">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <div class="ai-help-body">
            <div id="aiQuestionView">
                <p class="ai-help-subtitle">Frequently asked questions:</p>

                <div class="ai-help-list">
                    <button type="button" class="ai-help-item" data-key="openings" data-label="What job openings are available?">
                        <span>What job openings are available?</span>
                        <i class="fas fa-chevron-right"></i>
                    </button>

                    <button type="button" class="ai-help-item" data-key="apply" data-label="How do I apply for a job?">
                        <span>How do I apply for a job?</span>
                        <i class="fas fa-chevron-right"></i>
                    </button>

                    <button type="button" class="ai-help-item" data-key="documents" data-label="What documents are required?">
                        <span>What documents are required?</span>
                        <i class="fas fa-chevron-right"></i>
                    </button>

                    <button type="button" class="ai-help-item" data-key="deadline" data-label="How can I check the application deadline?">
                        <span>How can I check the application deadline?</span>
                        <i class="fas fa-chevron-right"></i>
                    </button>

                    <button type="button" class="ai-help-item" data-key="status" data-label="How do I know my application status?">
                        <span>How do I know my application status?</span>
                        <i class="fas fa-chevron-right"></i>
                    </button>
                </div>

                <div class="ai-help-footer-action">
                    <a href="/Home/Contact" class="ai-support-btn">
                        <i class="fas fa-comment-alt"></i>
                        <span>Contact Support</span>
                    </a>
                </div>
            </div>

            <div id="aiAnswerView" class="ai-answer-view" style="display:none;">
                <button id="aiBackBtn" type="button" class="ai-back-btn">
                    <i class="fas fa-arrow-left"></i>
                    <span>Go Back</span>
                </button>

                <div class="ai-answer-card">
                    <div class="ai-answer-question" id="aiAnswerQuestion"></div>
                    <div class="ai-answer-text" id="aiAnswerText"></div>
                </div>

                <div class="ai-help-footer-action">
                    <a href="/Home/Contact" class="ai-support-btn">
                        <i class="fas fa-comment-alt"></i>
                        <span>Contact Support</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>