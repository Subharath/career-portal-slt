@* AI Helper Floating Button + Chat Widget *@

<button id="aiFab" class="ai-fab" type="button" aria-label="AI Help">
    <i class="fas fa-robot"></i>
</button>

<div id="aiWidget" class="ai-widget shadow-lg" aria-hidden="true">
    <div class="ai-header">
        <div class="d-flex align-items-center gap-2">
            <i class="fas fa-robot"></i>
            <strong>SLT AI Helper</strong>
        </div>
        <button id="aiClose" class="btn btn-sm btn-light" type="button" aria-label="Close">
            <i class="fas fa-times"></i>
        </button>
    </div>

    <div id="aiMessages" class="ai-messages">
        <div class="ai-msg bot">
            Hi 👋 I’m your AI helper. Ask me about openings, how to apply, required documents, or anything on this portal.
        </div>
    </div>

    <div class="ai-input">
        <input id="aiText" class="form-control" placeholder="Type your question..." />
        <button id="aiSend" class="btn btn-primary" type="button">Send</button>
    </div>
</div> 