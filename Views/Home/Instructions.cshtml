@{
    ViewData["Title"] = "Instructions";
}

<style>
    .swal-text {
        color: black;
    }

    .swal-button {
        color: black;
        border-color: navy;
    }

    .swal-title {
        color: navy;
    }
</style>

@*<partial name="_LoadingPartial" />*@

<div class="card">
  <div class="card-header">
        General Guidelines & Instructions on Application Form
  </div>
  <div class="card-body">
    <h5 class="card-title"></h5>
    <p class="card-text">
        <ul>
            <li><span class="required"></span> marked entries are manadatory.</li>
            <li>Each attachment size must not exceed 1MB.</li>
            <li>Age is calculated as of the closing date of the application or the date of application for Talent Pool.</li>
            <li>For Advanced Level exam results, only the core subjects of the main stream need to be entered. Grades for optional subjects will be disregarded.</li>
            <li>Please make ready the following documents in .pdf or .jpg format (each not exceeding 1MB) before starting to fill the application form
                <ul>
                    <li>Result sheets of Ordinary & Advanced Level exams</li>
                    <li>Cerficates of Higher & Professional qualifications</li>
                    <li>Service letters of employments (optional)</li>
                    <li>Curriculum Vitae</li>
                    <li>NIC/Passport</li>
                    <li>Birth Certificate</li>
                    <li>Driving License</li>
                </ul>
            </li>
            <li>For certain job positions, some of the aforementioned documents may not be mandatory.</li>
            <li><b>Important Notice:</b> For the best experience, please complete this application form using a desktop or laptop. Due to the complexity and size of the form, mobile devices are not recommended.</li>
        </ul>
    </p>
  </div>
</div>


