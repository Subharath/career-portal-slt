@{
    ViewData["Title"] = "Join";
}

<div class="row">
    <div class="row mt-2 p-5 bg-light text-black border border-1 border-light rounded-3">
        <form asp-action="InitApply" asp-controller="Application">
            <input type="hidden" id="jobPositionName" name="jobPositionName" />

            <div class="form-group row">
                <div class="col-3 form-group">
                    <p class="control-label required">Select your interested job position</p>
                </div>
                <div class="col-4 form-group">
                    <select asp-items="@ViewBag.JobPosition" id="intakeCode" name="intakeCode" class="form-select form-select-sm" required autofocus>
                        <option disabled selected></option>
                    </select>
                </div>
                <div class="col-2 form-group">
                    <button type="submit" class="btn btn-primary btn-sm">Proceed</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="row">
    <p>Please note that Applications and CVs submitted for Talent Pool, will be retained only for a period of six months and securely discarded thereafter.</p>
</div>

@section Scripts {

    <script>
        $(document).ready(function() {
            $("#intakeCode").on('change', function (ev) {
                
                var selectedText = $("#intakeCode").find('option:selected').text();
                
                $("#jobPositionName").val(selectedText);

            });

        });
    </script>
}
